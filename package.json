{
  "name": "juanheng-retirement-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src --configLoader native --pool=threads --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "smoke:production": "node scripts/production-smoke.mjs",
    "audit:security": "node scripts/security-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.10",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.19.0"
}
